# EditorConfig - HarbourBuilder
# http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 3
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd,rc}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{png,ico,icns,bmp,zip,dll,exe,obj,o,lib,a,res,sqlite,dbf,cdx,mov}]
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
