{
  "id": "screen.cons_invoices",
  "kind": "screen",
  "layout": "master-detail",
  "title": "Invoices (master-detail)",
  "dataRef": "data.cons_invoices",
  "keyField": "code",
  "searchFields": ["code", "client", "status"],
  "grid": {
    "columns": [
      { "id": "code", "label": "Invoice #", "type": "text", "required": true },
      { "id": "date", "label": "Date", "type": "text", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "msg": "Use ISO date YYYY-MM-DD" },
      { "id": "client", "label": "Client", "type": "lookup", "lookup": "lookup.parties", "required": true },
      { "id": "project", "label": "Project", "type": "lookup", "lookup": "lookup.projects" },
      { "id": "status", "label": "Status", "type": "select", "options": ["Open", "Posted", "Settled", "Cancelled"] },
      { "id": "currency", "label": "Cur.", "type": "select", "options": ["EUR", "USD", "GBP"] },
      { "id": "total", "label": "Total", "type": "money", "format": "money", "align": "right", "min": 0 },
      { "id": "notes", "label": "Notes", "type": "text", "maxLength": 120 }
    ]
  },
  "toolbar": ["add", "edit", "delete", "print", "pdf", "excel", "refresh"],
  "detail": {
    "title": "Invoice lines",
    "dataRef": "data.cons_invoice_lines",
    "masterKey": "invoice",
    "keyField": "code",
    "searchFields": ["code", "article", "description"],
    "grid": {
      "columns": [
        { "id": "code", "label": "Line #", "type": "text", "required": true },
        { "id": "invoice", "label": "Invoice", "type": "text" },
        { "id": "article", "label": "Article", "type": "select", "options": ["CONSULT-DEV", "CONSULT-PM", "CONSULT-UX", "AUDIT", "TRAINING", "SUPPORT", "OTHER"] },
        { "id": "description", "label": "Description", "type": "text", "required": true },
        { "id": "qty", "label": "Qty", "type": "text", "align": "right", "min": 0 },
        { "id": "price", "label": "Price", "type": "money", "format": "money", "align": "right", "min": 0 },
        { "id": "amount", "label": "Amount", "type": "money", "format": "money", "align": "right", "min": 0 }
      ]
    },
    "toolbar": ["add", "edit", "delete", "refresh"]
  }
}
