{
  "id": "screen.users",
  "kind": "screen",
  "layout": "list",
  "title": "Users",
  "dataRef": "data.users",
  "keyField": "code",
  "searchFields": [
    "code",
    "name",
    "email",
    "role"
  ],
  "grid": {
    "columns": [
      {
        "id": "code",
        "label": "User code",
        "type": "text"
      },
      {
        "id": "name",
        "label": "Name",
        "type": "text"
      },
      {
        "id": "email",
        "label": "E-mail",
        "type": "text"
      },
      {
        "id": "role",
        "label": "Role",
        "type": "select",
        "options": [
          "admin",
          "user"
        ]
      },
      {
        "id": "active",
        "label": "Active",
        "type": "checkbox"
      },
      {
        "id": "defaultCompany",
        "label": "Default company",
        "type": "select",
        "options": [
          "HQ",
          "MAD",
          "BCN",
          "FER"
        ]
      },
      {
        "id": "defaultApp",
        "label": "Default app",
        "type": "select",
        "options": [
          "clinic",
          "demo",
          "services",
          "retail",
          "ferreteria"
        ],
        "hint": "Preferred app at login if that company has it linked; otherwise company defaultApp."
      },
      {
        "id": "password",
        "label": "Password",
        "type": "password",
        "hint": "Plain on edit; only CRC stored. Blank keeps current."
      }
    ]
  },
  "toolbar": [
    "add",
    "edit",
    "delete",
    "refresh"
  ]
}
