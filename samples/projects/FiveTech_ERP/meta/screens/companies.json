{
  "id": "screen.companies",
  "kind": "screen",
  "layout": "list",
  "title": "Companies",
  "dataRef": "data.companies",
  "keyField": "code",
  "searchFields": [
    "code",
    "name",
    "city",
    "taxId"
  ],
  "grid": {
    "columns": [
      {
        "id": "code",
        "label": "Code",
        "type": "text"
      },
      {
        "id": "name",
        "label": "Name",
        "type": "text"
      },
      {
        "id": "currency",
        "label": "Currency",
        "type": "text"
      },
      {
        "id": "taxId",
        "label": "Tax ID",
        "type": "text"
      },
      {
        "id": "city",
        "label": "City",
        "type": "text"
      },
      {
        "id": "country",
        "label": "Country",
        "type": "text"
      },
      {
        "id": "verticals",
        "label": "Apps (verticals)",
        "type": "checklist",
        "options": [
          "clinic",
          "demo",
          "services",
          "retail",
          "ferreteria"
        ],
        "hint": "Each checked pack becomes an app linked to this company (meta/verticals/<name>/)."
      },
      {
        "id": "defaultApp",
        "label": "Default app",
        "type": "select",
        "options": [
          "clinic",
          "demo",
          "services",
          "retail",
          "ferreteria"
        ],
        "hint": "App opened when the user switches to this company (must be one of the linked verticals)."
      },
      {
        "id": "active",
        "label": "Active",
        "type": "checkbox"
      }
    ]
  },
  "toolbar": [
    "add",
    "edit",
    "delete",
    "refresh"
  ]
}
