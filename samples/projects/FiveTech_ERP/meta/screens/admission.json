{
  "id": "screen.admission",
  "kind": "screen",
  "layout": "wizard",
  "title": "Admission wizard",
  "dataRef": "data.patient_cards",
  "keyField": "code",
  "steps": [
    {"id":"s1","label":"Patient","fields":["code","name","dob"]},
    {"id":"s2","label":"Contact","fields":["phone","email","city"]},
    {"id":"s3","label":"Clinical","fields":["coverage","blood","allergies","active"]}
  ],
  "fields": [
    {"id":"code","label":"Code","type":"text"},
    {"id":"name","label":"Name","type":"text"},
    {"id":"dob","label":"DOB","type":"text"},
    {"id":"phone","label":"Phone","type":"text"},
    {"id":"email","label":"E-mail","type":"text"},
    {"id":"city","label":"City","type":"text"},
    {"id":"coverage","label":"Coverage","type":"select","options":["Private","Public","Insurance"]},
    {"id":"blood","label":"Blood","type":"select","options":["A+","A-","B+","B-","O+","O-"]},
    {"id":"allergies","label":"Allergies","type":"text"},
    {"id":"active","label":"Active","type":"checkbox"}
  ]
}
