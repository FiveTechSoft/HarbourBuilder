{
  "id": "screen.quotes",
  "kind": "screen",
  "layout": "document",
  "title": "Quotes (document + totals)",
  "dataRef": "data.quotes",
  "keyField": "code",
  "taxRate": 21,
  "amountField": "amount",
  "totalFields": {"subtotal": "subtotal", "tax": "tax", "total": "total"},
  "grid": {
    "columns": [
      {"id":"code","label":"Quote #","type":"text"},
      {"id":"date","label":"Date","type":"text"},
      {"id":"patient","label":"Patient","type":"text"},
      {"id":"status","label":"Status","type":"select","options":["Draft","Sent","Accepted","Rejected"]},
      {"id":"currency","label":"Cur.","type":"select","options":["EUR","USD"]},
      {"id":"subtotal","label":"Subtotal","type":"money","format":"money","align":"right"},
      {"id":"tax","label":"Tax","type":"money","format":"money","align":"right"},
      {"id":"total","label":"Total","type":"money","format":"money","align":"right"}
    ]
  },
  "toolbar": ["add","edit","delete","print","pdf","excel","refresh"],
  "detail": {
    "title": "Quote lines",
    "dataRef": "data.quote_lines",
    "masterKey": "quote",
    "keyField": "code",
    "grid": {
      "columns": [
        {"id":"code","label":"Line","type":"text"},
        {"id":"quote","label":"Quote","type":"text"},
        {"id":"article","label":"Article","type":"select","options":["CONSULT","LAB","IMAGING","OTHER"]},
        {"id":"description","label":"Description","type":"text"},
        {"id":"qty","label":"Qty","type":"text","align":"right"},
        {"id":"price","label":"Price","type":"money","format":"money","align":"right"},
        {"id":"amount","label":"Amount","type":"money","format":"money","align":"right"}
      ]
    },
    "toolbar": ["add","edit","delete","refresh"]
  }
}
